# Variáveis do docker-compose.yml. Copie para .env (que nunca vai para o git) e preencha.

# Senha do PostgreSQL do container. Use só letras, números, - e _: ela entra numa URL de conexão,
# e caracteres como @ / : # quebrariam a URL. Gere no servidor (não precisa de Node) com:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Mínimo de 32 caracteres; a API não sobe com menos. Gere com:
#   openssl rand -hex 48
JWT_SECRET=

# Endereço em que o Caddy atende e o endereço exato que o usuário digita no navegador.
#
# Com domínio apontando para o servidor (portas 80 e 443 abertas), o certificado é automático:
#   SITE_ADDRESS=intellifinance.exemplo.com.br
#   PUBLIC_URL=https://intellifinance.exemplo.com.br
#
# Só com IP: certificado da CA interna do Caddy. O navegador avisa na primeira visita, mas a
# sessão funciona. Em http puro, não: o cookie de refresh é Secure e o navegador o descarta.
#   SITE_ADDRESS=https://203.0.113.10
#   PUBLIC_URL=https://203.0.113.10
#
# Para testar na própria máquina:
#   SITE_ADDRESS=localhost
#   PUBLIC_URL=https://localhost
SITE_ADDRESS=
PUBLIC_URL=

# Portas publicadas no host. Troque se o servidor já tiver outro serviço nelas; em porta diferente
# de 443, o PUBLIC_URL precisa incluí-la (https://203.0.113.10:8443).
# HTTP_PORT=80
# HTTPS_PORT=443

# Proxies confiáveis à frente da API. O padrão 1 é o próprio Caddy; some 1 para cada proxy a mais
# (Cloudflare, nginx do servidor), senão o limite de tentativas de login conta todos juntos.
# TRUST_PROXY_HOPS=1

# Versão das imagens. O padrão `latest` é o último push na main que passou no CI. Para voltar a uma
# versão anterior, fixe a tag do commit (sha-<hash completo>, listadas na aba Packages do GitHub) e
# rode `docker compose up -d`. Enquanto a tag estiver fixada, o deploy automático daquele lado não
# muda nada.
# BACKEND_TAG=sha-<hash do commit>
# FRONTEND_TAG=sha-<hash do commit>
