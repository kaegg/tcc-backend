# Variáveis do docker-compose.yml. Copie para .env (que nunca vai para o git) e preencha.

# Senha do PostgreSQL do container. Use só letras, números, - e _: ela entra numa URL de conexão,
# e caracteres como @ / : # quebrariam a URL. Gere no servidor (não precisa de Node) com:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Mínimo de 32 caracteres; a API não sobe com menos. Gere com:
#   openssl rand -hex 48
JWT_SECRET=

# Endereço exato que aparece na barra do navegador, sem barra final. A API recusa login vindo de
# qualquer outro. Aceita mais de um, separados por vírgula, para os dois acessos conviverem:
#   PUBLIC_URL=http://localhost:8080,https://intellifinance.exemplo.com.br
# http:// só funciona com localhost: em http://IP o navegador descarta o cookie de sessão.
PUBLIC_URL=http://localhost:8080

# Porta do servidor em que o sistema atende, só para a própria máquina (127.0.0.1). O túnel SSH
# e o túnel da Cloudflare apontam para http://localhost:8080. Troque se a 8080 estiver ocupada.
# HTTP_PORT=8080

# 0.0.0.0 expõe a porta para a rede. Não é necessário com túnel, e em http://IP a sessão não
# funciona (ver PUBLIC_URL).
# BIND_ADDRESS=127.0.0.1

# Sem túnel, com domínio apontando direto para o servidor, o Caddy pode emitir o certificado: use
# o domínio aqui, BIND_ADDRESS=0.0.0.0 e publique as portas 80 e 443 no compose.
# SITE_ADDRESS=:80

# Proxies à frente da API: o Caddy e o proxy local (cloudflared ou docker-proxy).
# TRUST_PROXY_HOPS=2

# Modelo do chatbot, baixado por `sh deploy.sh ollama`. Para trocar de variante, mude aqui e rode
# o comando de novo; as variantes testadas e o motivo da escolha ficam na documentação da TCC-019.
# OLLAMA_MODEL=qwen2.5:7b

# Quanto tempo o modelo fica carregado na memória sem uso. -1 = sempre (evita a espera de recarga
# na primeira mensagem depois de uma pausa). Use, por exemplo, 30m para liberar memória do servidor.
# OLLAMA_KEEP_ALIVE=-1

# Versão das imagens. O padrão `latest` é o último push na main que passou no CI. Para voltar a uma
# versão anterior, fixe a tag do commit (sha-<hash completo>, listadas na aba Packages do GitHub) e
# rode `sh deploy.sh backend` (ou `web`). Enquanto a tag estiver fixada, atualizações não mudam
# aquele lado.
# BACKEND_TAG=sha-<hash do commit>
# FRONTEND_TAG=sha-<hash do commit>
