# Porta do servidor HTTP
PORT=3000

# Origens do frontend liberadas no CORS, separadas por virgula e sem barra final.
# localhost e 127.0.0.1 sao origens DIFERENTES para o navegador: se voce abrir o
# frontend por um endereco que nao esta nesta lista, toda requisicao e bloqueada.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL — troque SUA_SENHA pela senha do usuario postgres
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/intellifinance?schema=public"

# Banco usado pelos testes que escrevem de verdade (test/schema-constraints.e2e-spec.ts).
# Sem esta variavel esses testes sao pulados, e o restante da suite continua rodando.
# DATABASE_URL_TEST="postgresql://postgres:SUA_SENHA@localhost:5432/intellifinance_test?schema=public"

# Autenticacao. Gere um segredo proprio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio
# Access token curto; a renovacao e feita pelo refresh token em cookie httpOnly.
# ACCESS_TOKEN_TTL_MINUTES=15
# Vencimento absoluto da sessao.
# SESSION_TTL_DAYS=7
# Numero de proxies confiaveis a frente da API (para o limite de tentativas ver o IP real).
# TRUST_PROXY_HOPS=1

# LLM local (Ollama). A URL precisa ser da rede local (localhost, IP privado ou
# nome de servico do Docker): a aplicacao recusa subir apontando para fora (RNF06).
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# Tempo maximo de uma resposta, em milissegundos. Em CPU o qwen2.5:7b leva 6-14 s.
# OLLAMA_TIMEOUT_MS=60000
# Chamadas simultaneas ao Ollama; acima disso o chatbot responde "ocupado".
# OLLAMA_MAX_IN_FLIGHT=4

# Coleta anonima de metricas de uso (TCC-030), so das contas que aceitaram os
# Termos de Uso. Qualquer valor diferente de true desliga: nada e gravado, e o
# navegador nem conta.
# USAGE_METRICS_ENABLED=false

# Dados de demonstracao do seed.
# Sem SEED_DEMO=true o seed cria apenas as categorias do sistema. A senha nao
# tem valor padrao de proposito: sem ela o seed aborta, em vez de criar uma
# conta com senha previsivel. Nao usar estas variaveis em producao.
# SEED_DEMO=true
# SEED_DEMO_NAME="Usuário de demonstração"
# SEED_DEMO_EMAIL=demo@intellifinance.local
# SEED_DEMO_PASSWORD=
