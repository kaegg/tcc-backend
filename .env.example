# Porta do servidor HTTP
PORT=3000

# Origem do frontend (Vite) liberada no CORS
CORS_ORIGIN=http://localhost:5173

# PostgreSQL — troque SUA_SENHA pela senha do usuario postgres
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/intellifinance?schema=public"

# Autenticacao. Gere um segredo proprio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio
JWT_EXPIRES_IN=1d

# Dados de demonstracao do seed.
# Sem SEED_DEMO=true o seed cria apenas as categorias do sistema. A senha nao
# tem valor padrao de proposito: sem ela o seed aborta, em vez de criar uma
# conta com senha previsivel. Nao usar estas variaveis em producao.
# SEED_DEMO=true
# SEED_DEMO_NAME="Usuário de demonstração"
# SEED_DEMO_EMAIL=demo@intellifinance.local
# SEED_DEMO_PASSWORD=
