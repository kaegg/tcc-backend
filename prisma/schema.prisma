// Esquema fisico do IntelliFinance.
//
// persistir usuarios, lancamentos, categorias, interacoes relevantes e 
// metricas de avaliacao em banco relacional. Concentra as restricoes de 
// integridade. As restricoes que o schema.prisma nao expressa,
// estao no fim do arquivo da migracao inicial.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

/// Tipo do lancamento financeiro.
///
/// Os rotulos ficam em minusculo e em portugues por tres motivos: sao valores
/// de dominio, e o padrao idiomatico de enum no PostgreSQL, e mantem o contrato
/// que o frontend ja usa em `src/lib/types.ts`, evitando traducao.
enum TransactionType {
  receita
  despesa

  @@map("transaction_type")
}

/// Por qual das duas interfaces o lancamento foi criado.
enum TransactionSource {
  formulario
  assistente

  @@map("transaction_source")
}

/// Autor da mensagem de chat.
enum ChatRole {
  user
  assistant

  @@map("chat_role")
}

/// Modo de interacao medido no estudo comparativo.
///
/// Repete os valores de TransactionSource de proposito: a tabela de metricas e
/// deliberadamente desacoplada do dominio financeiro, e compartilhar o enum
/// criaria a dependencia que a anonimizacao quer evitar.
enum InteractionMode {
  formulario
  assistente

  @@map("interaction_mode")
}

/// Desfecho de uma tarefa cronometrada.
enum TaskOutcome {
  sucesso
  falha
  abandono

  @@map("task_outcome")
}

/// Usuario do sistema.
model User {
  id String @id @default(uuid(7)) @db.Uuid
  name String @db.VarChar(120)
  email String @unique @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Lados opostos das relacoes. O Prisma exige a declaracao nos dois lados —
  /// sem elas o `prisma validate` falha com "missing an opposite relation
  /// field". Nao geram coluna alguma: a tabela `users` tem so os seis campos
  /// acima, e a chave estrangeira mora em `transactions.user_id` e em
  /// `conversations.user_id`. Servem apenas para navegar a relacao no client,
  /// e so carregam dado quando a consulta pedir `include` explicitamente.
  transactions  Transaction[]
  conversations Conversation[]

  @@map("users")
}

/// Categoria financeira do sistema, compartilhada por todos os usuarios
model Category {
  id String @id @default(uuid(7)) @db.Uuid
  name String          @db.VarChar(60)
  type TransactionType
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  transactions Transaction[]

  /// Nao existem duas categorias com o mesmo nome e tipo.
  @@unique([name, type], map: "categories_name_type_key")
  /// Alvo da chave estrangeira composta de Transaction. E este indice que
  /// permite ao PostgreSQL recusar um lancamento cuja categoria seja de tipo incompativel.
  @@unique([id, type], map: "categories_id_type_key")
  @@index([type, isActive])
  @@map("categories")
}

/// Lancamento financeiro, receita ou despesa.
model Transaction {
  id String @id @default(uuid(7)) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  type TransactionType

  /// numeric(12,2). Nunca ponto flutuante: valor financeiro em double acumula
  /// erro de arredondamento e quebraria a conferencia dos totais dos
  /// relatorios contra os lancamentos persistidos.
  amount Decimal @db.Decimal(12, 2)

  /// Data do fato financeiro, sem hora e sem fuso, diferente de `created_at`,
  /// que e o instante do registro. Separar os dois evita que um lancamento
  /// feito as 23h50 do dia 31 caia no mes seguinte do relatorio.
  date DateTime @db.Date
  description String            @db.VarChar(255)
  source      TransactionSource @default(formulario)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Exclusao logica. Preenchida, o lancamento some das listagens e dos
  /// relatorios, mas o registro do que o participante fez durante a tarefa
  /// cronometrada permanece disponivel para a analise.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Chave estrangeira composta: alem de existir, a categoria precisa ser do
  /// mesmo tipo do lancamento.
  ///
  /// Restrict nos dois lados: categoria em uso nao e apagada (retira-se de
  /// circulacao com `is_active = false`) e o tipo de uma categoria em uso nao
  /// muda por baixo dos lancamentos que dependem dele.
  category Category @relation(fields: [categoryId, type], references: [id, type], onDelete: Restrict, onUpdate: Restrict)

  /// Listagem e filtro por periodo.
  @@index([userId, date])
  /// Distribuicao por categoria do resumo mensal.
  @@index([userId, categoryId, date])
  @@map("transactions")
}

/// Conversa do chatbot.
model Conversation {
  id String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  title  String @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

/// Mensagem trocada no chatbot.
///
/// Sem `user_id` proprio de proposito: a posse vem da conversa. Uma coluna
/// redundante poderia divergir de `conversations.user_id` e criar insconsistencias.
model ChatMessage {
  id String @id @default(uuid(7)) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           ChatRole
  content        String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

/// Metrica de uso coletada no estudo comparativo.
///
/// Tabela deliberadamente desligada do dominio financeiro: nao ha chave
/// estrangeira para User. O participante aparece so como codigo opaco, o que
/// atende "os participantes estao identificados apenas por codigos"
/// e "dados pessoais desnecessarios nao sao coletados", e permite
/// exportar a base de analise sem carregar identidade junto.
model UsageMetric {
  id String @id @default(uuid(7)) @db.Uuid
  participantCode String @map("participant_code") @db.VarChar(40)
  sessionCode     String @map("session_code") @db.VarChar(40)
  mode     InteractionMode
  taskCode String          @map("task_code") @db.VarChar(40)
  startedAt  DateTime  @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  /// Duracao em milissegundos, gravada no fim da tarefa. Redundante com o par
  /// de instantes de proposito: e o numero que entra na analise e ele nao muda
  /// se o fuso do servidor mudar entre a coleta e o processamento.
  durationMs Int? @map("duration_ms")

  /// Cliques no modo formulario, mensagens enviadas no modo assistente.
  interactionCount Int @default(0) @map("interaction_count")
  errorCount       Int @default(0) @map("error_count")

  outcome TaskOutcome?

  /// Observacao do pesquisador. Nunca recebe valor financeiro nem dado
  /// pessoal do participante.
  notes String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Uma linha por tarefa, por modo, por sessao. Impede a linha duplicada que
  /// distorceria silenciosamente as medias da. Repeticao legitima
  /// (piloto e execucao real) usa um `session_code` diferente.
  @@unique([participantCode, sessionCode, mode, taskCode])
  @@index([participantCode])
  @@index([mode, taskCode])
  @@map("usage_metrics")
}
